icalAlign=middle;align=center;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2049" y="1826" width="253" height="84" as="geometry"/></mxCell><mxCell id="n111" value="&lt;span style='font-size:12px'&gt;⚠ 一进程一会话&lt;br&gt;&lt;span style='font-size:11px'&gt;139MB/标签&lt;/span&gt;&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2302" y="1826" width="253" height="84" as="geometry"/></mxCell><mxCell id="n112" value="口径说明:&lt;b&gt;CapResume&lt;/b&gt; = 引擎能把一条会话接着跑;&lt;b&gt;CapFork&lt;/b&gt; = OneCreat 自己的消息日志&lt;b&gt;就是&lt;/b&gt;模型可见历史(dsh / pi 的是投影)—— 所以 compact 与会话 rewind 在 sidecar 引擎下被拒,而基于文件检查点的代码 rewind 不受影响。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="78" y="1918" width="2444" height="34" as="geometry"/></mxCell><mxCell id="n113" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B9C3D0;" vertex="1" parent="1"><mxGeometry x="60" y="1998" width="2480" height="76" as="geometry"/></mxCell><mxCell id="n114" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#25344F;" vertex="1" parent="1"><mxGeometry x="76" y="2022" width="70" height="28" as="geometry"/></mxCell><mxCell id="n115" value="" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="152" y="2023" width="30" height="26" as="geometry"/></mxCell><mxCell id="n116" value="现有模块&lt;br&gt;(OneCreat 内核已有)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="2016" width="351" height="40" as="geometry"/></mxCell><mxCell id="n117" value="" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="547" y="2023" width="30" height="26" as="geometry"/></mxCell><mxCell id="n118" value="新建模块 / 新增字段&lt;br&gt;(本次迁移要写的)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="585" y="2016" width="351" height="40" as="geometry"/></mxCell><mxCell id="n119" value="" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="942" y="2023" width="30" height="26" as="geometry"/></mxCell><mxCell id="n120" value="引擎(sidecar / 进程内)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="980" y="2016" width="351" height="40" as="geometry"/></mxCell><mxCell id="n121" value="" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1337" y="2023" width="30" height="26" as="geometry"/></mxCell><mxCell id="n122" value="外部系统 / 外部真源" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1375" y="2016" width="351" height="40" as="geometry"/></mxCell><mxCell id="n123" value="" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1732" y="2023" width="30" height="26" as="geometry"/></mxCell><mxCell id="n124" value="可选 · 未来 · 待拍板&lt;br&gt;(虚线边框)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1770" y="2016" width="351" height="40" as="geometry"/></mxCell><mxCell id="n125" value="" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2127" y="2023" width="30" height="26" as="geometry"/></mxCell><mxCell id="n126" value="门禁 · 业务决策点&lt;br&gt;fail-closed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2165" y="2016" width="351" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p70569" name="材料流水线与立项时序"><mxGraphModel dx="2500" dy="1780" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1780" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:26px;color:#25344F'&gt;图 4　两条主链 —— A 一键材料(oneclick) / B 对话型立项(conversational)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="2400" height="40" as="geometry"/></mxCell><mxCell id="n3" value="&lt;span style='font-size:14px;color:#5A6B82'&gt;对应《架构纲要 v1》§4。左链靠依赖 DAG 自动编排,右链靠人机对话 + 老板决断;两链的工具调用都过 Pipeline.Before。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="64" width="2400" height="28" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style='font-size:17px'&gt;A　一键材料 oneclick　—　collab / platform / sprint 三段共 19 种材料&lt;/b&gt;" style="fillColor=#3F5B8B;strokeColor=#3F5B8B;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="108" width="1170" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style='font-size:17px'&gt;B　对话型立项 conversational　—　source / establish 两段&lt;/b&gt;" style="fillColor=#E07B1E;strokeColor=#E07B1E;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1270" y="108" width="1170" height="56" as="geometry"/></mxCell><mxCell id="n6" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;1&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;UI 点「生成 教案」&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;项目工作台 → 材料卡片(或批量排队)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n7" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;2&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;workflow 服务查注册表&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;内嵌 workflow_registry.json;&lt;b&gt;未注册材料类型 fail-closed&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="298" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;3&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;拓扑排序 + 依赖检查&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;缺硬依赖「技术方案」→ 先排上游,或给阻塞提示&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="406" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;4&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;新建会话 = 材料作业&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;kind=material · ProjectID · Engine = 用户所选 / 默认 dsh&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="514" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;5&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;组 prompt&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;skill 调用 + 依赖产物&lt;b&gt;全文&lt;/b&gt; + 准则注入 + 项目记忆 + 环境说明&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="622" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;6&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;Controller.Submit → 引擎跑&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;每个工具调用都经 &lt;b&gt;toolpolicy.Pipeline.Before&lt;/b&gt; 门禁&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="730" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;7&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;产物写入项目七目录对应桶&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;02_平台材料 / 06_项目协作 / 07_竞赛提交&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="838" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;8&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;质检四件套&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;① 假成功检测(exit 0 但零交付物 = 失败)② 失败重试 1 次&lt;br&gt;③ AI 看图质检(&lt;b&gt;只报告不自动改&lt;/b&gt;)④ 图表组装说明&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="946" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;9&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;证据 Receipt + ledger 对账&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;complete_step ↔ todo_write 匹配;items 状态回写&lt;/spa