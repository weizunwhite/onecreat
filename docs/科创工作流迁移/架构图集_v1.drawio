style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1270" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#3F5B8B;font-weight:bold;font-size:22px;width:44px'&gt;12&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;UI 工作台刷新&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;材料 DAG 上该节点转绿 + 证据进度条&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="1378" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:22px;width:44px'&gt;1&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;课题库点「立项」&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;题卡 state = candidate;业务线 C / B / G 必选,负责人可后补&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="190" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n30" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:22px;width:44px'&gt;2&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;查活跃线程(归一化 key)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;同题已有进行中 → &lt;b&gt;409 拒绝&lt;/b&gt;,不允许重复发起&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="298" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:22px;width:44px'&gt;3&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;新建 Thread + 会话&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;kind=establish;深度模式且无 note → 先 &lt;b&gt;awaiting_input&lt;/b&gt;(不能把硬停伪装成完成)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="406" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n30" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:22px;width:44px'&gt;4&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;skill idea-to-build 跑&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;工具调用同样过 Pipeline.Before 门禁&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="514" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n32" target="n34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:22px;width:44px'&gt;5&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;产出「立项依据」→ 线程 succeeded&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;outputs[] 落在选题工坊 / 项目内&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="622" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n34" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:22px;width:44px'&gt;6&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;进入决策收件箱 awaiting_decision&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;&lt;b&gt;业务决策点,不是安全审批;YOLO / bypass 不能跳过&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="730" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n36" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="&lt;table style='width:100%'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:22px;width:44px'&gt;7&lt;/td&gt;&lt;td style='text-align:left'&gt;&lt;b style='font-size:14px'&gt;老板亲手点 —— 二选一&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;只有老板在结果页明确点击后才能发号建档;不得手工编 P 号或用移动文件代替立项&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="1290" y="838" width="1130" height="88" as="geometry"/></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n38" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b style='font-size:15px'&gt;建档　→　numbering.Issuer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;预告号 → 建档时带 &lt;b&gt;expected_code 回验&lt;/b&gt;,号变了就拒绝&lt;br&gt;(迁移期 NAS 权威 / 冻结日切本地文件)&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1280" y="966" width="560" height="116" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b style='font-size:15px'&gt;建七目录 + project.json&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;复制 产题 / 评题 / 立项依据 → 01_立项定题&lt;br&gt;&lt;b&gt;来源区原始 Markdown 保留,不移动、不删&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1280" y="1096" width="560" height="116" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b style='font-size:15px'&gt;stage = 2(立项)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;题卡 state = established + project_code&lt;br&gt;append workflow.jsonl;P 卡 / NAS 同步为可选外部步骤&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1280" y="1226" width="560" height="116" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b style='font-size:15px'&gt;未立项　→　reason &lt;b&gt;必填&lt;/b&gt;&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;无 reason 直接拒绝提交&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1870" y="966" width="560" height="116" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b style='font-size:15px'&gt;搬到 _未立项/&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;01_在研项目/_未立项/&amp;lt;题名&amp;gt;_&amp;lt;组别&amp;gt;_&amp;lt;YYYYMMDD&amp;gt;/&lt;br&gt;+ 未立项原因.md&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1870" y="1096" width="560" height="116" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b style='font-size:15px'&gt;题卡 state = unestablished&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;文件位置就是状态 —— 不另设状态字段&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1870" y="1226" width="560" height="116" as="geometry"/></mxCell><mxCell id="n48" value="建档" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n40" target="n42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n49" value="未立项" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n40" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n42" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n43" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n45" target="n46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n46" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n54" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#FBE3E3;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="60" y="1500" width="2380" height="150" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b style='font-size:18px;color:#8E1414'&gt;决策收件箱 ≠ 安全审批 —— 两个语义独立、并列的东西&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;approvalBroker(现有)&lt;/b&gt;管的是&lt;b&gt;工具调用的安全&lt;/b&gt;:这条 bash 能不能跑、这个文件能不能写。它有会话内授权、有 YOLO / bypass 模式,老板嫌烦可以一键全批。&lt;br&gt;&lt;b&gt;决策收件箱(新建)&lt;/b&gt;管的是&lt;b&gt;产品决策&lt;/b&gt;:立项建档 / 未立项 / 产题准则 confirm / 项目段位拨动。这些是「老板亲手点」的业务判断,&lt;b&gt;YOLO 与 bypass 都不能跳过它&lt;/b&gt;,也不允许 agent 代为确认。两者在代码里并列、互不复用。" style="text;html=1;align=left;verticalAlign=top;fontSize=13.5;fontColor=#5A2020;" vertex="1" parent="1"><mxGeometry x="90" y="1516" width="2320" height="120" as="geometry"/></mxCell><mxCell id="n56" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B9C3D0;" vertex="1" parent="1"><mxGeometry x="60" y="1680" width="2380" height="76" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#25344F;" vertex="1" parent="1"><mxGeometry x="76" y="1704" width="70" height="28" as="geometry"/></mxCell><mxCell id="n58" value="" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="152" y="1705" width="30" height="26" as="geometry"/></mxCell><mxCell id="n59" value="现有模块&lt;br&gt;(OneCreat 内核已有)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="1698" width="334" height="40" as="geometry"/></mxCell><mxCell id="n60" value="" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="530" y="1705" width="30" height="26" as="geometry"/></mxCell><mxCell id="n61" value="新建模块 / 新增字段&lt;br&gt;(本次迁移要写的)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="568" y="1698" width="334" height="40" as="geometry"/></mxCell><mxCell id="n62" value="" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="908" y="1705" width="30" height="26" as="geometry"/></mxCell><mxCell id="n63" value="引擎(sidecar / 进程内)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="946" y="1698" width="334" height="40" as="geometry"/></mxCell><mxCell id="n64" value="" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1286" y="1705" width="30" height="26" as="geometry"/></mxCell><mxCell id="n65" value="外部系统 / 外部真源" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1324" y="1698" width="334" height="40" as="geometry"/></mxCell><mxCell id="n66" value="" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1664" y="1705" width="30" height="26" as="geometry"/></mxCell><mxCell id="n67" value="可选 · 未来 · 待拍板&lt;br&gt;(虚线边框)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1702" y="1698" width="334" height="40" as="geometry"/></mxCell><mxCell id="n68" value="" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2042" y="1705" width="30" height="26" as="geometry"/></mxCell><mxCell id="n69" value="门禁 · 业务决策点&lt;br&gt;fail-closed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2080" y="1698" width="334" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p69163" name="部署拓扑"><mxGraphModel dx="2400" dy="1400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:26px;color:#25344F'&gt;图 5　部署拓扑 —— 一台老师 / 创始人的 Mac + 外部依赖&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="2300" height="40" as="geometry"/></mxCell><mxCell id="n3" value="&lt;span style='font-size:14px;color:#5A6B82'&gt;对应《架构纲要 v1》§0 形态拍板 + §2 L0。不做桌面 App 壳:就是 onecreat-web 单二进制起本地服务、浏览器当 UI。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="64" width="2300" height="28" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#F7F9FC;strokeColor=#25344F;" vertex="1" parent="1"><mxGeometry x="520" y="170" width="1180" height="850" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style='font-size:18px;color:#25344F'&gt;老师 / 创始人的 Mac(单机 · 本机数据不出门)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="544" y="180" width="1140" height="32" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style='font-size:16px'&gt;浏览器 UI(Chrome / Safari)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;http://127.0.0.1:3700　+　本地 token　—— 与 dsh web 同形态,不打 Wails 包&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="222" width="1100" height="92" as="geometry"/></mxCell><mxCell id="n7" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#EDF2FA;strokeColor=#3F5B8B;" vertex="1" parent="1"><mxGeometry x="560" y="392" width="1100" height="372" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style='font-size:17px;color:#1B2F52'&gt;onecreat-web　—— 单 Go 静态二进制(CGO_ENABLED=0),make release-web 全平台发行包&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="580" y="400" width="1060" height="34" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b style='font-size:15px'&gt;Go 内核&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;boot.Build → control.Controller&lt;br&gt;→ toolpolicy.Pipeline → engine.TurnEngine&lt;br&gt;event / eventwire / eventstream · runtime scopes&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="584" y="444" width="522" height="140" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b style='font-size:15px'&gt;内嵌资源(随二进制发行)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;workflow_registry.json(启动即校验)&lt;br&gt;skill 索引 · 板卡注册表 · 知识库&lt;br&gt;&lt;b&gt;方法论正文离线可用 —— 断网能干活&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1122" y="444" width="518" height="140" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b style='font-size:15px'&gt;领域服务【新】&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;internal/project · internal/workflow · internal/topic · internal/numbering · internal/evidence(扩展)&lt;br&gt;挂 workspace scope(boot.Factory),自持锁&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="584" y="600" width="1056" height="140" as="geometry"/></mxCell><mxCell id="n12" value="POST /rpc/&amp;lt;Method&amp;gt;　·　SSE /events　·　GET /snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;startArrow=block;startFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b style='font-size:14px'&gt;runtime/node&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;内置 Node(共享一份)&lt;br&gt;dsh 要 20+,pi 要 22.19+&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="812" width="353" height="116" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b style='font-size:14px'&gt;runtime/dsh【默认】&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;sidecar 子进程 · stdio JSON-RPC&lt;br&gt;≈ 90MB;22 个包锁死 rc.8&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="933" y="812" width="353" height="116" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b style='font-size:14px'&gt;runtime/pi【新增】&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;sidecar 子进程 · pi --mode rpc&lt;br&gt;≈ 139MB;&lt;b&gt;首次切换时按需下载&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1306" y="812" width="353" height="116" as="geometry"/></mxCell><mxCell id="n16" value="spawn + stdio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;entryX=0.5;entryY=0;startArrow=block;startFill=1;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="spawn + stdio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.5;entryY=0;startArrow=block;startFill=1;" edge="1" parent="1" source="n7" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="默认发行包只带 dsh;&lt;code&gt;SKIP_SIDECARS=dsh,pi&lt;/code&gt; 可跳过。native 引擎编在主二进制里,零额外体积。&lt;br&gt;linux/arm64 无 sidecar 构建机 ⇒ 该平台只能 engine=native。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="560" y="940" width="1100" height="60" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b style='font-size:16px'&gt;DeepSeek 直连&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;api.deepseek.com · DEEPSEEK_API_KEY&lt;br&gt;&lt;b&gt;内部模式&lt;/b&gt;:用户自己的 key,不脱敏&lt;/span&gt;" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="392" width="400" height="130" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b style='font-size:16px'&gt;文件真源&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;/Users/localwork/课题/&lt;br&gt;&lt;br&gt;· 01_在研项目/P26X-NNN_短名/(七目录)&lt;br&gt;· 00_产题评题/(产题 · 评题 · 准则正本)&lt;br&gt;· _未立项/&lt;br&gt;&lt;br&gt;&lt;b&gt;OneCreat 原地读写,不搬数据&lt;/b&gt;&lt;/span&gt;" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="400" height="250" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b style='font-size:16px'&gt;oneup-skills 仓&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;40+ 竞赛 / 教学 skill 正本&lt;br&gt;随发行包内置 + 可挂本地仓覆盖&lt;/span&gt;" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="400" height="120" as="geometry"/></mxCell><mxCell id="n22" value="内部模式:模型直连" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeWidth=3;strokeColor=#2E7D32;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="n19" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="读写文件真源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#757575;startArrow=block;startFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.7;" edge="1" parent="1" source="n20" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#757575;startArrow=block;startFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.95;" edge="1" parent="1" source="n21" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#F0F0F0;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1750" y="200" width="590" height="480" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b style='font-size:17px;color:#3E3E3E'&gt;教师平台 t.weizunxy.com(外部)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1772" y="212" width="546" height="32" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b style='font-size:14px'&gt;身份&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;登录 / session · features(feature key = workflow)&lt;br&gt;points 点数 · tiers 档位&lt;/span&gt;" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1774" y="254" width="542" height="84" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b style='font-size:14px'&gt;AI 网关(商业模式)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;OpenAI 兼容端点 · 按机构点数计费&lt;br&gt;&lt;b&gt;客户端只见 tier-N;真实模型 / 路由是商业秘密&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1774" y="350" width="542" height="92" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b style='font-size:14px'&gt;未来(现在只设计不实现)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;· onecreat_projects 影子表&lt;br&gt;　(id, org_id, owner_teacher_id, student_alias, stage)&lt;br&gt;· AccountSession 加 UserID / OrgID / Role / Students[]&lt;br&gt;· billing.ReportOutcome(产出物维度计费事件)&lt;br&gt;· numbering.Issuer 第三实现 = 平台发号&lt;br&gt;· /api/onecreat/refresh 续期(平台侧前置)&lt;/span&gt;" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1774" y="456" width="542" height="206" as="geometry"/></mxCell><mxCell id="n30" value="商业模式&lt;br&gt;只有身份与计量走网" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeWidth=3;strokeColor=#7B1FA2;startArrow=block;startFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.4;" edge="1" parent="1" source="n7" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b style='font-size:15px'&gt;(可选)NAS 项目总库镜像 192.168.6.131&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;00_项目总库分类投放 · 学生软链 · SMB 共享&lt;br&gt;&lt;b&gt;由外部脚本 project_sync.py 维护&lt;/b&gt;;OneCreat 只提供「运行同步」按钮 —— &lt;b&gt;去留待 M0 拍板&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1750" y="720" width="590" height="150" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b style='font-size:15px'&gt;(可选)教师平台项目包上传&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;现状只走 iOS(写 token 只在 Keychain);&lt;br&gt;是否让 OneCreat 持老师 token 直传 —— &lt;b&gt;待 M0 拍板&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1750" y="900" width="590" height="130" as="geometry"/></mxCell><mxCell id="n33" value="可选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#9E9E9E;dashed=1;dashPattern=8 4;exitX=1;exitY=0.8;entryX=0;entryY=0.4;" edge="1" parent="1" source="n7" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="可选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#9E9E9E;dashed=1;dashPattern=8 4;exitX=1;exitY=0.95;entryX=0;entryY=0.4;" edge="1" parent="1" source="n7" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#B9C3D0;" vertex="1" parent="1"><mxGeometry x="80" y="1050" width="1620" height="120" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b style='font-size:15px;color:#2E7D32'&gt;■ 内部模式(先做)&lt;/b&gt;　:　DeepSeek 直连(自己的 key)· 无网关 · 无脱敏 · billing 为 no-op · 文件真源在本机 —— &lt;b&gt;断网也能干活&lt;/b&gt;(方法论正文全内置)&lt;br&gt;&lt;b style='font-size:15px;color:#7B1FA2'&gt;■ 商业模式(架构预留)&lt;/b&gt;　:　登录教师平台 → feature key &lt;code&gt;workflow&lt;/code&gt; 门控整个科创工作台 → AI 走平台网关(档位 tier-N,模型名隐藏)→ 点数 / 产出物计费&lt;br&gt;两种模式共用同一份二进制与同一套领域服务,差别只在 internal/account 的 Gateway 是否被赋值。" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="104" y="1062" width="1580" height="96" as="geometry"/></mxCell><mxCell id="n37" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#B9C3D0;" vertex="1" parent="1"><mxGeometry x="1750" y="1050" width="590" height="120" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;连线样式&lt;/b&gt;&lt;br&gt;&lt;span style='color:#2E7D32'&gt;━━ 绿&lt;/span&gt; 内部模式　&lt;span style='color:#7B1FA2'&gt;━━ 紫&lt;/span&gt; 商业模式&lt;br&gt;&lt;span style='color:#757575'&gt;━━ 灰&lt;/span&gt; 本机文件 / 仓库　&lt;span style='color:#9E9E9E'&gt;┅┅ 灰虚线&lt;/span&gt; 可选 · 待拍板" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1772" y="1062" width="546" height="96" as="geometry"/></mxCell><mxCell id="n39" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B9C3D0;" vertex="1" parent="1"><mxGeometry x="80" y="1200" width="2260" height="76" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#25344F;" vertex="1" parent="1"><mxGeometry x="96" y="1224" width="70" height="28" as="geometry"/></mxCell><mxCell id="n41" value="" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="172" y="1225" width="30" height="26" as="geometry"/></mxCell><mxCell id="n42" value="现有模块&lt;br&gt;(OneCreat 内核已有)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="210" y="1218" width="314" height="40" as="geometry"/></mxCell><mxCell id="n43" value="" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="530" y="1225" width="30" height="26" as="geometry"/></mxCell><mxCell id="n44" value="新建模块 / 新增字段&lt;br&gt;(本次迁移要写的)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="568" y="1218" width="314" height="40" as="geometry"/></mxCell><mxCell id="n45" value="" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="888" y="1225" width="30" height="26" as="geometry"/></mxCell><mxCell id="n46" value="引擎(sidecar / 进程内)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="926" y="1218" width="314" height="40" as="geometry"/></mxCell><mxCell id="n47" value="" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1246" y="1225" width="30" height="26" as="geometry"/></mxCell><mxCell id="n48" value="外部系统 / 外部真源" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1284" y="1218" width="314" height="40" as="geometry"/></mxCell><mxCell id="n49" value="" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1604" y="1225" width="30" height="26" as="geometry"/></mxCell><mxCell id="n50" value="可选 · 未来 · 待拍板&lt;br&gt;(虚线边框)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1642" y="1218" width="314" height="40" as="geometry"/></mxCell><mxCell id="n51" value="" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1962" y="1225" width="30" height="26" as="geometry"/></mxCell><mxCell id="n52" value="门禁 · 业务决策点&lt;br&gt;fail-closed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2000" y="1218" width="314" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p74028" name="迁移路线图"><mxGraphModel dx="2600" dy="1410" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1410" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:26px;color:#25344F'&gt;图 6　迁移路线图 —— 六期主线 + 一条并行引擎线 + 后置商业化&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="2500" height="40" as="geometry"/></mxCell><mxCell id="n3" value="&lt;span style='font-size:14px;color:#5A6B82'&gt;对应《架构纲要 v1》§7 路线图 + §8 待拍板问题。主线串行、E 线并行、C 线后置;每期一句内容 + 一句验收。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="64" width="2500" height="28" as="geometry"/></mxCell><mxCell id="axis" value="时间 →" style="html=1;strokeWidth=3;strokeColor=#25344F;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="168" as="sourcePoint"/><mxPoint x="2534" y="168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n4" value="" style="fillColor=#F6F8FC;strokeColor=#C7D2E0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="2480" height="300" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style='font-size:20px'&gt;主线&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;line-height:1.45'&gt;M0 → M5&lt;br&gt;串行,六期&lt;/span&gt;" style="fillColor=#25344F;strokeColor=#25344F;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="220" height="300" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style='font-size:15px'&gt;M0　拍板与收口&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;产品边界 5 问 · 注册表收口(枚举合一 / status 清理 / skill 仓对齐)· P 卡 stage 回写 project.json 方案&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;color:#1B5E20;line-height:1.5'&gt;&lt;b&gt;验收&lt;/b&gt;　一页决策记录;注册表 v17 + 校验测试&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="300" y="232" width="302" height="236" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b style='font-size:15px'&gt;M1　领域内核&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;internal/project · workflow · topic · numbering + evidence 持久化;内嵌注册表;guard 测试;CLI reasonix workflow {scan,status,materials}&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;color:#1B5E20;line-height:1.5'&gt;&lt;b&gt;验收&lt;/b&gt;　对 P26C-020_飞鸟志 跑通 scan / status;全部守卫绿&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="622" y="232" width="302" height="236" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b style='font-size:15px'&gt;M2　一键材料流水线&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;材料作业 = 会话;依赖注入 / 重试 / 假成功 / 看图质检;产物落桶;新 event.Kind 注册&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;color:#1B5E20;line-height:1.5'&gt;&lt;b&gt;验收&lt;/b&gt;　CLI 生成「技术方案 → 教案」链,证据对账通过&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="944" y="232" width="302" height="236" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b style='font-size:15px'&gt;M3　对话型 + 决策收件箱&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;线程状态机;立项 / 未立项全链;发号 Issuer(NAS 适配 + 本地)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;color:#1B5E20;line-height:1.5'&gt;&lt;b&gt;验收&lt;/b&gt;　一题从候选 → 建档,全程在 OneCreat 完成&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1266" y="232" width="302" height="236" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b style='font-size:15px'&gt;M4　科创工作台 UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;mainView=workflow:项目看板 / 课题库 / 项目工作台 / 决策收件箱 / 准则台;bindings 生成;mock&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;color:#1B5E20;line-height:1.5'&gt;&lt;b&gt;验收&lt;/b&gt;　浏览器完成 M2 / M3 全部操作;tsc / build / web 标签测试 绿&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1588" y="232" width="302" height="236" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b style='font-size:15px'&gt;M5　数据切换&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;冻结 NASApp 发号;迁 P 卡 stage / 编号登记簿 / RLHF 资产;NASApp 相关入口停用或改只读&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;color:#1B5E20;line-height:1.5'&gt;&lt;b&gt;验收&lt;/b&gt;　双写期结束,单真源&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1910" y="232" width="302" height="236" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="fillColor=#F6F8FC;strokeColor=#C7D2E0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="2480" height="290" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b style='font-size:20px'&gt;E　并行&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;line-height:1.45'&gt;pi 引擎线&lt;br&gt;12 – 17.5 人日&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="220" height="290" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b style='font-size:14px'&gt;P0 spike&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;拉起 pi --mode rpc&lt;br&gt;一轮 prompt → agent_settled&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="622" y="564" width="255" height="172" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b style='font-size:14px'&gt;P1 门禁&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;onecreat-gate.ts + piDecider&lt;br&gt;e2e 五条(deny / ask批 / ask拒 /&lt;br&gt;计划模式拦写 / 取消 fail-closed)&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="889" y="564" width="255" height="172" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b style='font-size:14px'&gt;P2 网关红线&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;provider onecreat-gateway&lt;br&gt;模型 tier-N + resolve 取 token&lt;br&gt;逐条堵脱敏泄漏面&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1156" y="564" width="255" height="172" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b style='font-size:14px'&gt;P3 证据桥&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;complete_step 工具桥&lt;br&gt;接 internal/evidence&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1423" y="564" width="255" height="172" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b style='font-size:14px'&gt;P4 能力 / 切换 UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;Capability 声明 + Supports&lt;br&gt;新会话选引擎 · 状态栏&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1690" y="564" width="255" height="172" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b style='font-size:14px'&gt;P5 分发&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11.5px;line-height:1.5'&gt;runtime/pi + 共享 runtime/node&lt;br&gt;按需下载 · SKIP_SIDECARS&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1957" y="564" width="255" height="172" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;验收&lt;/b&gt;　e2e 门禁五条绿;新会话可选引擎。　&lt;b&gt;建议&lt;/b&gt;:先做 P0+P1(5–7 人日)拿到能过门禁 e2e 的 spike,与 dsh 做一次真实对照,再决定是否长期双养。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#8A4B00;" vertex="1" parent="1"><mxGeometry x="622" y="748" width="1590" height="40" as="geometry"/></mxCell><mxCell id="n26" value="" style="fillColor=#F6F8FC;strokeColor=#C7D2E0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="2480" height="200" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b style='font-size:20px'&gt;C　后置&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;line-height:1.45'&gt;商业化&lt;/span&gt;" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="220" height="200" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b style='font-size:16px'&gt;C　商业化(M4 之后再起)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;feature key &lt;code&gt;workflow&lt;/code&gt; 门控整个科创工作台 · onecreat_projects 影子表 · AccountSession 学生主体 · billing.ReportOutcome 产出物计费 · /api/onecreat/refresh 续期&lt;br&gt;&lt;b&gt;验收&lt;/b&gt;　真老师账号端到端:登录 → 门控生效 → AI 走网关 → 点数扣减 → 阶段上报&lt;/span&gt;" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1588" y="868" width="946" height="130" as="geometry"/></mxCell><mxCell id="n29" value="现阶段 = &lt;b&gt;内部模式&lt;/b&gt;:创始人 / 自家老师自用,DeepSeek 直连,billing 为 no-op。&lt;br&gt;商业化接口&lt;b&gt;现在只设计不实现&lt;/b&gt;(§6),避免为了「以后能卖」把内部可用性拖慢。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="868" width="1258" height="130" as="geometry"/></mxCell><mxCell id="n30" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#FBE3E3;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="2480" height="190" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b style='font-size:17px;color:#8E1414'&gt;M0 需要老板拍板的 5 个产品边界问题(不拍板,M1 就会做出要返工的假设)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="84" y="1072" width="2430" height="32" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b style='font-size:15px'&gt;① 发号权威&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;迁移期保留 NAS(HTTP 适配)→ 冻结日切本地文件?还是一步到位本地?&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C62828;fontColor=#5A2020;verticalAlign=middle;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="84" y="1112" width="474" height="120" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b style='font-size:15px'&gt;② NAS 总库去留&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;项目总库 / 学生软链 / SMB 继续由外部 project_sync.py 维护(OneCreat 只给按钮),还是完全退役?&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C62828;fontColor=#5A2020;verticalAlign=middle;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="572" y="1112" width="474" height="120" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b style='font-size:15px'&gt;③ 平台上传由谁&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;项目包继续只走 iOS(token 只在 Keychain),还是让 OneCreat 持老师 token 直传?&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C62828;fontColor=#5A2020;verticalAlign=middle;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="1112" width="474" height="120" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b style='font-size:15px'&gt;④ NASApp 并行期&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;并行多久?哪些功能(如看板 P 卡)在 OneCreat 上线前继续用 NASApp?&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C62828;fontColor=#5A2020;verticalAlign=middle;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1548" y="1112" width="474" height="120" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b style='font-size:15px'&gt;⑤ pi 引擎&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;直接双养,还是先 P0+P1 spike 与 dsh 对照再定?&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C62828;fontColor=#5A2020;verticalAlign=middle;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2036" y="1112" width="474" height="120" as="geometry"/></mxCell><mxCell id="n37" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B9C3D0;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="2480" height="76" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#25344F;" vertex="1" parent="1"><mxGeometry x="76" y="1314" width="70" height="28" as="geometry"/></mxCell><mxCell id="n39" value="" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="152" y="1315" width="30" height="26" as="geometry"/></mxCell><mxCell id="n40" value="现有模块&lt;br&gt;(OneCreat 内核已有)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="1308" width="351" height="40" as="geometry"/></mxCell><mxCell id="n41" value="" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="547" y="1315" width="30" height="26" as="geometry"/></mxCell><mxCell id="n42" value="新建模块 / 新增字段&lt;br&gt;(本次迁移要写的)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="585" y="1308" width="351" height="40" as="geometry"/></mxCell><mxCell id="n43" value="" style="fillColor=#E2F1E6;strokeColor