tSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="816" width="175" height="424" as="geometry"/></mxCell><mxCell id="n48" value="&lt;b style='font-size:14px'&gt;Controller.Submit → pi sidecar&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;pi --mode rpc&lt;br&gt;--no-extensions --no-skills --no-context-files -na&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="255" y="868" width="406" height="118" as="geometry"/></mxCell><mxCell id="n49" value="&lt;b style='font-size:14px'&gt;pi agent loop&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;tool_execution_start(事件已发给 Go)&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="683" y="868" width="406" height="118" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b style='font-size:14px'&gt;&lt;b&gt;tool_call&lt;/b&gt; 钩子&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;可 block · 串行 preflight · async 可 await&lt;br&gt;pi/extensions/onecreat-gate.ts&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1111" y="868" width="406" height="118" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b style='font-size:14px'&gt;await ctx.ui.input({ title:&amp;quot;__onecreat_gate__&amp;quot; })&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;stdout → extension_ui_request&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=cente