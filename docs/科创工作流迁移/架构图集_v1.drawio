"geometry"/></mxCell><mxCell id="n60" value="&lt;b style='font-size:14px'&gt;文件真源 /Users/localwork/课题/&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;项目七目录 · 00_产题评题&lt;br&gt;准则正本&lt;/span&gt;" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="539" y="1326" width="297" height="118" as="geometry"/></mxCell><mxCell id="n61" value="&lt;b style='font-size:14px'&gt;oneup-skills 仓&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;40+ 竞赛 / 教学 skill 正本&lt;/span&gt;" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="848" y="1326" width="297" height="118" as="geometry"/></mxCell><mxCell id="n62" value="&lt;b style='font-size:14px'&gt;(可选)NAS 项目总库镜像&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;学生软链 / SMB;&lt;br&gt;外部脚本 project_sync.py&lt;/span&gt;" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1157" y="1326" width="297" height="118" as="geometry"/></mxCell><mxCell id="n63" value="&lt;b style='font-size:14px'&gt;(可选)教师平台项目包上传&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;待拍板:现走 iOS Keychain&lt;/span&gt;" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1466" y="1326" width="297" height="118" as="geometry"/></mxCell><mxCell id="n64" value="" style="fillColor=#FCFCFC;strokeColor=#B9C3D0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1805" y="118" width="550" height="1356" as="geometry"/></mxCell><mxCell id="n65" value="八条设计铁律(全部继承自现有架构守卫,不新造)" style="fillColor=#3F5B8B;strokeColor=#3F5B8B;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1805" y="118" width="550" height="48" as="geometry"/></mxCell><mxCell id="n66" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;科创工作流是&lt;b&gt;应用策略&lt;/b&gt;,只长在 control.Controller 之上;绝不碰 engine.TurnEngine 接缝,绝不让 engine / agent import 新领域包&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="178" width="522" height="152" as="geometry"/></mxCell><mxCell id="n67" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;2&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;阶段 / 课题 / 项目状态&lt;b&gt;不上 Controller、不上 turnState&lt;/b&gt;;新建领域服务自持锁,行数红线不动&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="340" width="522" height="152" as="geometry"/></mxCell><mxCell id="n68" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;3&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;门禁只有一条 &lt;b&gt;toolpolicy.Pipeline&lt;/b&gt;(plan mode → gate → PreToolUse → checkpoint → 注入);任何引擎都过它,fail-closed,无开关可绕&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="502" width="522" height="152" as="geometry"/></mxCell><mxCell id="n69" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;4&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;&lt;b&gt;注册表唯一真源&lt;/b&gt;:阶段 / 材料 / skill / 依赖 / 输出 / 平台 file_type 全在一份 workflow_registry.json,内嵌进二进制、启动即校验、未注册 fail-closed&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="664" width="522" height="152" as="geometry"/></mxCell><mxCell id="n70" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;5&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;&lt;b&gt;文件位置即状态,项目目录即真源&lt;/b&gt;:原地接管 01_在研项目/P26X-NNN_短名/,不搬数据、不建第二真源;运行状态用 append-only workflow.jsonl&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="826" width="522" height="152" as="geometry"/></mxCell><mxCell id="n71" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;6&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;&lt;b&gt;业务决策点 ≠ 安全审批&lt;/b&gt;:立项建档 / 未立项 / 准则 confirm / 段位 走独立的决策收件箱,&lt;b&gt;YOLO 与 bypass 都不能跳过&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="988" width="522" height="152" as="geometry"/></mxCell><mxCell id="n72" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;7&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;引擎&lt;b&gt;按新会话选择&lt;/b&gt;,写进 session.Record.Engine(write-once),会话中途换引擎硬拒;全局配置只做默认值&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="1150" width="522" height="152" as="geometry"/></mxCell><mxCell id="n73" value="&lt;table style='font-size:12.5px;line-height:1.5'&gt;&lt;tr&gt;&lt;td style='color:#E07B1E;font-weight:bold;font-size:20px;vertical-align:top'&gt;8&lt;/td&gt;&lt;td style='text-align:left;padding-left:8px'&gt;&lt;b&gt;SaaS 红线不变&lt;/b&gt;:真实模型名不得出现在 UI / 日志 / 事件流 / 错误体;方法论正文随发行包内置,只有身份与计量走网,&lt;b&gt;断网能干活&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#D6DEE9;verticalAlign=middle;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1819" y="1312" width="522" height="152" as="geometry"/></mxCell><mxCell id="n74" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B9C3D0;" vertex="1" parent="1"><mxGeometry x="70" y="1498" width="2285" height="76" as="geometry"/></mxCell><mxCell id="n75" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#25344F;" vertex="1" parent="1"><mxGeometry x="86" y="1522" width="70" height="28" as="geometry"/></mxCell><mxCell id="n76" value="" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="162" y="1523" width="30" height="26" as="geometry"/></mxCell><mxCell id="n77" value="现有模块&lt;br&gt;(OneCreat 内核已有)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="200" y="1516" width="318" height="40" as="geometry"/></mxCell><mxCell id="n78" value="" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="524" y="1523" width="30" height="26" as="geometry"/></mxCell><mxCell id="n79" value="新建模块 / 新增字段&lt;br&gt;(本次迁移要写的)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="562" y="1516" width="318" height="40" as="geometry"/></mxCell><mxCell id="n80" value="" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="886" y="1523" width="30" height="26" as="geometry"/></mxCell><mxCell id="n81" value="引擎(sidecar / 进程内)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="924" y="1516" width="318" height="40" as="geometry"/></mxCell><mxCell id="n82" value="" style="fillColor=#F0F0F0;strokeColor=#9E9E9E;fontColor=#4E4E4E;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1248" y="1523" width="30" height="26" as="geometry"/></mxCell><mxCell id="n83" value="外部系统 / 外部真源" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1286" y="1516" width="318" height="40" as="geometry"/></mxCell><mxCell id="n84" value="" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1610" y="1523" width="30" height="26" as="geometry"/></mxCell><mxCell id="n85" value="可选 · 未来 · 待拍板&lt;br&gt;(虚线边框)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1648" y="1516" width="318" height="40" as="geometry"/></mxCell><mxCell id="n86" value="" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1972" y="1523" width="30" height="26" as="geometry"/></mxCell><mxCell id="n87" value="门禁 · 业务决策点&lt;br&gt;fail-closed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2010" y="1516" width="318" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p63037" name="领域模型与存储"><mxGraphModel dx="2400" dy="1620" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1620" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:26px;color:#25344F'&gt;图 2　领域模型与存储 —— 实体 · 关系 · 文件真源&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="2300" height="40" as="geometry"/></mxCell><mxCell id="n3" value="&lt;span style='font-size:14px;color:#5A6B82'&gt;对应《架构纲要 v1》§3 领域模型。索引只是产物,文件位置才是状态;OneCreat 不搬数据、不建第二真源。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="64" width="2300" height="28" as="geometry"/></mxCell><mxCell id="n4" value="" style="fillColor=#FCFCFC;strokeColor=#B9C3D0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="1460" height="720" as="geometry"/></mxCell><mxCell id="n5" value="核心实体与关系(§3 实体表)" style="fillColor=#3F5B8B;strokeColor=#3F5B8B;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="1460" height="42" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style='font-size:14px'&gt;Topic 题卡&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;扫描 00_产题评题 / _未立项 / P26* 合并而成&lt;br&gt;(索引只是产物)&lt;br&gt;state: candidate → establishing&lt;br&gt;→ established / unestablished&lt;br&gt;归一化 key 一份实现,须与历史逐字节一致&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="95" y="180" width="300" height="150" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b style='font-size:15px'&gt;Project 项目&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;P26[CBG]-NNN · &amp;lt;项目根&amp;gt;/project.json&lt;br&gt;(保留 NASApp 格式 + 新增 stage / stage_updated_at)&lt;br&gt;七目录 · stage 1–8&lt;br&gt;孵化 / 立项 / 生产 / 发布同步 / 项目协作 /&lt;br&gt;授课交付 / 结题冲刺 / 回流归档&lt;br&gt;&lt;b&gt;目录永不搬家、永不手改名&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="340" height="170" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style='font-size:14px'&gt;Numbering 编号登记簿&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;接口 Issuer:&lt;br&gt;Local(课题/.onecreat/project_codes.json)&lt;br&gt;| NAS(HTTP 适配,迁移期权威)&lt;br&gt;| Platform(多机构时必需)&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="180" width="300" height="150" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b style='font-size:14px'&gt;Thread 对话线程&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;.onecreat/threads/&amp;lt;id&amp;gt;.json&lt;br&gt;queued → running → awaiting_input&lt;br&gt;→ succeeded → &lt;b&gt;awaiting_decision&lt;/b&gt; → decided&lt;br&gt;conversational 材料专用;同题禁止重复发起&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="95" y="390" width="300" height="150" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b style='font-size:14px'&gt;Decision 决策项&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;决策收件箱(进程内服务&lt;br&gt;+ 持久化到 workflow.jsonl)&lt;br&gt;pending → accepted / rejected(含 reason)&lt;br&gt;类型:建档 / 未立项 / 准则 confirm / 段位&lt;br&gt;&lt;b&gt;不受 YOLO 影响&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="390" width="280" height="150" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b style='font-size:14px'&gt;MaterialJob 材料作业&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;= 一个 Controller 会话&lt;br&gt;(kind=material, ProjectID, Engine 任选)&lt;br&gt;queued → running → succeeded / failed&lt;br&gt;依赖注入 · 重试 1 次 · 假成功检测 · 看图质检&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="390" width="300" height="150" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b style='font-size:14px'&gt;Material 材料(25 种)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;注册表条目:type / stage / kind / skill /&lt;br&gt;deps / outputs / platform.file_type&lt;br&gt;五段:source · establish(conversational)&lt;br&gt;collab · platform · sprint(oneclick)&lt;br&gt;&lt;b&gt;未注册 fail-closed&lt;/b&gt;;别名表兼容旧名&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="390" width="300" height="150" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b style='font-size:14px'&gt;session.Record 会话身份&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;id / &lt;b&gt;Engine(write-once)&lt;/b&gt; / Store(转录引用)&lt;br&gt;/ workspace / kind / 时间戳 / 显示映射&lt;br&gt;+ &lt;b&gt;ProjectID(write-once)【新增字段】&lt;/b&gt;&lt;br&gt;一份 .sessions.json 索引;&lt;br&gt;转录归引擎,身份归 internal/session&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="95" y="610" width="300" height="170" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b style='font-size:14px'&gt;TopicRules 产题准则&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;00_产题评题/准则/(md 正本,版本化)&lt;br&gt;+ 反馈库 json(stars 1–5 / comment)&lt;br&gt;draft → confirmed →(rollback)&lt;br&gt;&lt;b&gt;Compose 时运行态注入,不进系统前缀缓存&lt;/b&gt;&lt;br&gt;确认权只在老板&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="610" width="470" height="170" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b style='font-size:14px'&gt;EvidenceLedger 证据台账&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;&amp;lt;项目&amp;gt;/02_平台材料/&amp;lt;短名&amp;gt;_evidence_ledger.json&lt;br&gt;(沿用 skill 契约)+ 运行时 Receipt&lt;br&gt;items{ slot, perishable, consumers, status }&lt;br&gt;三站接力 + OneCreat evidence 引擎对账 = 闭环&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="610" width="490" height="170" as="geometry"/></mxCell><mxCell id="n16" value="点「立项」→ 建线程" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="succeeded → awaiting_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="老板点「建档」→ 建七目录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="n10" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="预告号 → expected_code 回验&lt;br&gt;(号变了就拒绝)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n8" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="建档后 state=established + project_code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.