"n52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1742" y="996"/><mxPoint x="458" y="996"/></Array></mxGeometry></mxCell><mxCell id="n63" value="裁定通道 = pi &lt;b&gt;官方&lt;/b&gt;的 extension UI 子协议(rpc.md「Extension UI Protocol」),走同一条 stdio —— &lt;b&gt;零额外端口、零鉴权、随进程生灭&lt;/b&gt;,不像 loopback HTTP 方案会留孤儿 nonce&lt;br&gt;另需 &lt;code&gt;complete_step&lt;/code&gt; 工具桥(证据引擎是裁判)· provider &lt;code&gt;onecreat-gateway&lt;/code&gt; / 模型 &lt;code&gt;tier-N&lt;/code&gt; + resolve 回调取 token(解决 50 分钟轮换)· 脱敏要多堵:AssistantMessage.{api,provider,model} / PI_PROVIDER / PI_MODEL / get_available_models" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#8A4B00;" vertex="1" parent="1"><mxGeometry x="255" y="1156" width="1690" height="68" as="geometry"/></mxCell><mxCell id="gatebox" value="" style="none;" vertex="1" parent="1"><mxGeometry x="1990" y="130" width="1" height="1" as="geometry"/></mxCell><mxCell id="ge1" value="同一条 Pipeline.Before" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;strokeWidth=3;strokeColor=#C62828;dashed=0;exitX=0.5;exitY=0;" edge="1" parent="1" source="n19"><mxGeometry relative="1" as="geometry"><mxPoint x="1990" y="258" as="targetPoint"/><Array as="points"><mxPoint x="1241" y="178"/><mxPoint x="1968" y="178"/></Array></mxGeometry></mxCell><mxCell id="ge2" value="同一条 Pipeline.Before" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;strokeWidth=3;strokeColor=#C62828;dashed=0;exitX=0.5;exitY=0;" edge="1" parent="1" source="n35"><mxGeometry relative="1" as="geometry"><mxPoint x="1990" y="640" as="targetPoint"/><Array as="points"><mxPoint x="886" y="600"/><mxPoint x="1968" y="600"/></Array></mxGeometry></mxCell><mxCell id="ge3" value="同一条 Pipeline.Before" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;strokeWidth=3;strokeColor=#C62828;dashed=0;exitX=0.5;exitY=0;" edge="1" parent="1" source="n53"><mxGeometry relative="1" as="geometry"><mxPoint x="1990" y="1010" as="targetPoint"/><Array as="points"><mxPoint x="886" y="1014"/><mxPoint x="1968" y="1014"/></Array></mxGeometry></mxCell><mxCell id="n64" value="" style="fillColor=#FCFCFC;strokeColor=#B9C3D0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="2480" height="210" as="geometry"/></mxCell><mxCell id="n65" value="引擎选择规则(§5 · 报告 03 §6)" style="fillColor=#3F5B8B;strokeColor=#3F5B8B;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="2480" height="42" as="geometry"/></mxCell><mxCell id="n66" value="&lt;b style='font-size:15px'&gt;① 按新会话选择&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;新建会话 / 标签时选 &lt;b&gt;dsh(默认)&lt;/b&gt; / pi / native;&lt;br&gt;全局配置(onecreat.toml engine=)只做默认值&lt;br&gt;解析优先级:显式 Options.Engine &amp;gt; ONECREAT_ENGINE &amp;gt; cfg.Engine&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1348" width="590" height="132" as="geometry"/></mxCell><mxCell id="n67" value="&lt;b style='font-size:15px'&gt;② Record.Engine write-once&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;历史会话一律按它装配,不看当前默认值;&lt;br&gt;会话记录里写的是&lt;b&gt;实际跑它的引擎&lt;/b&gt;,永不硬编码 native&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="1348" width="590" height="132" as="geometry"/></mxCell><mxCell id="n68" value="&lt;b style='font-size:15px'&gt;③ 会话中途换引擎 —— 硬拒&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;转录真源在引擎侧,换引擎 = 制造假象;&lt;br&gt;未知引擎名在装配期报错(engine.UnsupportedError),不静默回退&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1310" y="1348" width="590" height="132" as="geometry"/></mxCell><mxCell id="n69" value="&lt;b style='font-size:15px'&gt;④ 能力不足的操作按 Supports 禁用&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Fork / Branch / Rewind(会话)/ Compact / Summarize 在 dsh、pi 下&lt;br&gt;给&lt;b&gt;人话原因&lt;/b&gt;禁用;requireCap 在动状态之前就拒,不留半改的影子会话&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1920" y="1348" width="590" height="132" as="geometry"/></mxCell><mxCell id="n70" value="" style="fillColor=#FCFCFC;strokeColor=#B9C3D0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1530" width="2480" height="448" as="geometry"/></mxCell><mxCell id="n71" value="Capability 矩阵:native / dsh / pi(报告 03 §5)" style="fillColor=#3F5B8B;strokeColor=#3F5B8B;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="1530" width="2480" height="42" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b style='font-size:12.5px'&gt;引擎&lt;/b&gt;" style="fillColor=#3F5B8B;strokeColor=#3F5B8B;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSiz