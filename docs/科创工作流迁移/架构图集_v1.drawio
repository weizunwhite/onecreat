p;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1276" y="1518" width="318" height="40" as="geometry"/></mxCell><mxCell id="n98" value="" style="fillColor=#FAFAFA;strokeColor=#9E9E9E;fontColor=#5E5E5E;dashed=1;dashPattern=8 4;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1600" y="1525" width="30" height="26" as="geometry"/></mxCell><mxCell id="n99" value="可选 · 未来 · 待拍板&lt;br&gt;(虚线边框)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1638" y="1518" width="318" height="40" as="geometry"/></mxCell><mxCell id="n100" value="" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1962" y="1525" width="30" height="26" as="geometry"/></mxCell><mxCell id="n101" value="门禁 · 业务决策点&lt;br&gt;fail-closed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2000" y="1518" width="318" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7030" name="双引擎与门禁链路"><mxGraphModel dx="2600" dy="2100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b style='font-size:26px;color:#25344F'&gt;图 3　双引擎与门禁链路 —— native / dsh / pi 都过同一条 Pipeline.Before&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="2500" height="40" as="geometry"/></mxCell><mxCell id="n3" value="&lt;span style='font-size:14px;color:#5A6B82'&gt;对应《架构纲要 v1》§5 + 调研报告 03 §4。门禁位置从「工具在哪执行」改判为「在哪一刻裁定」,fail-closed 无开关可绕。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="64" width="2500" height="28" as="geometry"/></mxCell><mxCell id="n4" value="" style="fillColor=#FFF5F5;strokeColor=#C62828;fontColor=#8E1414;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1990" y="130" width="550" height="1110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style='font-size:18px'&gt;toolpolicy.Pipeline.Before&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;line-height:1.45'&gt;唯一门禁流水线 —— 阶段顺序是已发布契约&lt;/span&gt;" style="fillColor=#C62828;strokeColor=#C62828;fontColor=#FFFFFF;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1990" y="130" width="550" height="92" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style='font-size:15px'&gt;① plan mode 只读门&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;计划模式下写工具直接拦下&lt;/span&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2016" y="250" width="498" height="82" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b style='font-size:15px'&gt;② 权限 Gate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;allow / ask / deny;&lt;b&gt;ask 在这里阻塞等真人&lt;/b&gt;(approvalBroker)&lt;/span&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2016" y="346" width="498" height="82" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style='font-size:15px'&gt;③ PreToolUse hook&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;用户自定义钩子可否决&lt;/span&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2016" y="442" width="498" height="82" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b style='font-size:15px'&gt;④ 写前检查点快照&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;internal/checkpoint;&lt;b&gt;放最后&lt;/b&gt; —— 被拒的调用不留回退点&lt;/span&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2016" y="538" width="498" height="82" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b style='font-size:15px'&gt;⑤ 上下文注入&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;job / memory / evidence 句柄随 ctx 进工具&lt;/span&gt;" style="fillColor=#FBE3E3;strokeColor=#C62828;fontColor=#8E1414;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2016" y="634" width="498" height="82" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b style='font-size:15px'&gt;返回 allow / ask / deny(+reason)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;三个引擎&lt;b&gt;同一口径&lt;/b&gt;;deny ⇒ 工具根本不执行,reason 作为工具结果回给模型&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#C62828;strokeColor=#8E1414;fontColor=#FFFFFF;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2016" y="742" width="498" height="86" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b style='font-size:15px;color:#8E1414'&gt;fail-closed 的四个断点&lt;/b&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt; Go 进程死 / 管道断 → dsh:pre-execute 通道断即 deny;pi:dialog 抛错 —— 官方保证「tool_call errors block the tool(fail-safe)」&lt;br&gt;&lt;b&gt;②&lt;/b&gt; Go 明确 deny → 工具不执行&lt;br&gt;&lt;b&gt;③&lt;/b&gt; 用户在裁定对话上取消 → pi 回 cancelled ⇒ input 返回 undefined,&lt;b&gt;扩展必须显式当 deny&lt;/b&gt;(唯一靠纪律的一处)&lt;br&gt;&lt;b&gt;④&lt;/b&gt; turn 被取消 → ctx.signal / AbortError 打断 await → 抛错即拦截&lt;br&gt;· 纯策略判定可传 60s timeout 兜底(超时 → undefined = deny);&lt;b&gt;ask 场景不传 timeout&lt;/b&gt;,等真人&lt;br&gt;· 唯一「挂住 ≠ 放行」的窗口:Go 侧活着但死锁 → 无限等,安全上可接受,靠 turn 超时兜底" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#5A2020;" vertex="1" parent="1"><mxGeometry x="2016" y="844" width="498" height="268" as="geometry"/></mxCell><mxCell id="n13" value="&lt;span style='font-size:12.5px;text-align:left'&gt;&lt;b&gt;⚠ 已知缺口(与上面的理想口径不符)&lt;/b&gt;&lt;br&gt;dsh 的 &lt;code&gt;handlePreExecute&lt;/code&gt; 在 &lt;b&gt;decision == ask 且 approver == nil&lt;/b&gt;(headless 无审批者)时&lt;b&gt;当前是放行&lt;/b&gt;,不是 fail-closed。&lt;b&gt;M2 待收口&lt;/b&gt;。pi 侧按纲要画:undefined / cancelled 一律当 deny。&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#FFF6DA;strokeColor=#E6A700;fontColor=#6B4E00;verticalAlign=middle;align=left;fontSize=12.5;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="2016" y="1118" width="498" height="104" as="geometry"/></mxCell><mxCell id="n14" value="" style="fillColor=#F6F8FC;strokeColor=#C7D2E0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="1885" height="262" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b style='font-size:20px'&gt;native&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;现有 · 开发 / 兜底&lt;br&gt;&lt;b&gt;hosted-tools&lt;/b&gt;&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="175" height="262" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b style='font-size:14px'&gt;Controller.Submit&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;一轮 turn 开始&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="255" y="200" width="263" height="120" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b style='font-size:14px'&gt;engine/native&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;进程内 agent.Runner&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="263" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b style='font-size:14px'&gt;模型流式&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;text / reasoning / tool_call&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="825" y="200" width="263" height="120" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b style='font-size:14px'&gt;toolpolicy.Pipeline.Before&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;同一条门禁&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="200" width="263" height="120" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b style='font-size:14px'&gt;工具在&lt;b&gt;本进程&lt;/b&gt;执行&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;hosted-tools&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1395" y="200" width="263" height="120" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b style='font-size:14px'&gt;Pipeline.After → event.Sink&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;→ SSE /events&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1680" y="200" width="263" height="120" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="工具执行位置 = 本进程 ⇒ 天然受控;这是 &lt;b&gt;hosted-tools&lt;/b&gt; 的含义" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#1B2F52;" vertex="1" parent="1"><mxGeometry x="255" y="330" width="1690" height="34" as="geometry"/></mxCell><mxCell id="n28" value="" style="fillColor=#F6F8FC;strokeColor=#C7D2E0;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="406" width="1885" height="396" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b style='font-size:20px'&gt;dsh&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;默认 · sidecar&lt;br&gt;&lt;b&gt;gated-tools&lt;/b&gt;&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="406" width="175" height="396" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b style='font-size:14px'&gt;Controller.Submit → dsh sidecar&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;node · stdio 换行分隔 JSON-RPC 2.0&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="255" y="458" width="406" height="112" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b style='font-size:14px'&gt;dsh 自己的 agent loop&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;工具在 &lt;b&gt;sidecar 进程&lt;/b&gt;,不在我们这边&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="683" y="458" width="406" height="112" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b style='font-size:14px'&gt;tools/pre-execute waterfall&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;调度器&lt;b&gt;派发前&lt;/b&gt;触发 · 串行&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1111" y="458" width="406" height="112" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b style='font-size:14px'&gt;dsh/plugins/control&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;OneCreat 自有控制面插件,await Go 裁定&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1539" y="458" width="406" height="112" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b style='font-size:14px'&gt;Engine.handlePreExecute&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;sidecar.go:814&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="255" y="608" width="406" height="112" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b style='font-size:14px'&gt;boot.dshDecider&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;→ 右侧 Pipeline.Before&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="683" y="608" width="406" height="112" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b style='font-size:14px'&gt;notify tool.preExecute.done&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;{ ID, Decision, Reason }&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1111" y="608" width="406" height="112" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b style='font-size:14px'&gt;allow → 工具在 sidecar 执行&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;&lt;b&gt;deny → 工具不执行&lt;/b&gt;,reason 回模型&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1539" y="608" width="406" height="112" as="geometry"/></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n32" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n34" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strok