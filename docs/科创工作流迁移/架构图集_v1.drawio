78" width="245" height="116" as="geometry"/></mxCell><mxCell id="n48" value="&lt;b style='font-size:14px'&gt;硬件 MCP&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;cmd/reasonix-hardware-mcp&lt;br&gt;Arduino / ESP-IDF / PlatformIO&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1515" y="678" width="245" height="116" as="geometry"/></mxCell><mxCell id="n49" value="&lt;b style='font-size:16px'&gt;engine.TurnEngine{ Start } / TurnHandle{ Cancel, Wait } + Capability(hosted · gated · resume · fork · streaming · approval)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;line-height:1.45'&gt;唯一接缝 —— internal/engine/boundary_test.go 守卫:多一个方法、多一个应用策略动词、多一个 import 就失败&lt;/span&gt;" style="fillColor=#25344F;strokeColor=#25344F;fontColor=#FFFFFF;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="840" width="1535" height="56" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b style='font-size:14px'&gt;native【现有 · 开发 / 兜底】&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;进程内 agent.Runner&lt;br&gt;声明 &lt;b&gt;hosted-tools&lt;/b&gt; —— 每个工具都在本进程、&lt;br&gt;经 toolpolicy 流水线执行&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="912" width="497" height="130" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b style='font-size:14px'&gt;dsh【默认】&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;sidecar · node · stdio JSON-RPC&lt;br&gt;tools/pre-execute → boot.dshDecider&lt;br&gt;→ Pipeline.Before　声明 &lt;b&gt;gated-tools&lt;/b&gt;&lt;/span&gt;" style="fillColor=#E2F1E6;strokeColor=#2E7D32;fontColor=#14481B;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="749" y="912" width="497" height="130" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b style='font-size:14px'&gt;pi【新增】&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;sidecar · pi --mode rpc&lt;br&gt;tool_call 钩子 + extension UI 阻塞子协议&lt;br&gt;→ boot.piDecider → Pipeline.Before　&lt;b&gt;gated-tools&lt;/b&gt;&lt;/span&gt;" style="fillColor=#FFF0DC;strokeColor=#E07B1E;fontColor=#8A4B00;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1268" y="912" width="497" height="130" as="geometry"/></mxCell><mxCell id="n53" value="boot.requireToolGating &lt;b&gt;fail-closed&lt;/b&gt;:既不声明 hosted-tools 也不声明 gated-tools 的引擎,在装配期被拒(engine.UnsupportedError)—— &lt;b&gt;没有任何配置开关可以绕过&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#8E1414;" vertex="1" parent="1"><mxGeometry x="230" y="1050" width="1535" height="40" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b style='font-size:14px'&gt;provider registry&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;OpenAI 兼容(DeepSeek / MiMo …) · Anthropic 原生&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="1138" width="502" height="68" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b style='font-size:14px'&gt;internal/account&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Gateway(URL · token · tier,自持锁)&lt;br&gt;+ CredentialSource:每请求取 token&lt;/span&gt;" style="fillColor=#E8EEF7;strokeColor=#3F5B8B;fontColor=#1B2F52;rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=middle;align