// ────────────────────────────────────────────────────────────
// 串口监视器「双曲线」演示固件 (ESP32)
//
// 每 40ms(约 25 次/秒)输出 sin / cos 两路数值,格式 "sin:数值 cos:数值"。
// 在监视器「曲线」视图里会画成两条不同颜色、不同频率的实时波形,
// 用来演示 Phase 2 的多路数据可视化(图例会分别显示 sin / cos 当前值)。
// ────────────────────────────────────────────────────────────

#include <math.h>

void setup() {
  Serial.begin(115200);  // 波特率要和监视器里选的一致(115200)
}

void loop() {
  float t = millis() / 1000.0;        // 当前时间(秒),作为波形相位
  float s = sin(t * 1.5) * 100.0;     // 正弦:幅度 100,较慢
  float c = cos(t * 2.5) * 60.0;      // 余弦:幅度 60,较快(故意不同,方便看出是两条线)

  // 命名格式 name:value —— 监视器按名字分成 sin、cos 两条曲线
  Serial.printf("sin:%.1f cos:%.1f\n", s, c);

  delay(40);  // 约 25 帧/秒,曲线平滑
}
