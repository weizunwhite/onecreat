# Wails build assets/output — mostly auto-generated (plists, manifests, compiled
# binary); ignore them but keep the committed designed app icon.
/build/*
!/build/appicon.png

# Commit our customized macOS Info.plist so the bundle id (dev.onecreat.desktop) is
# the same for local and CI builds — otherwise a fresh `wails build` regenerates the
# com.wails.<name> default and macOS treats the two as different apps.
!/build/darwin
/build/darwin/*
!/build/darwin/Info.plist

# Commit only our customized per-user NSIS installer template. wails_tools.nsh and
# everything else under build/ are regenerated by `wails build`, so stay ignored.
# (Each `!` un-ignore needs its parent dir un-ignored first.)
!/build/windows
/build/windows/*
!/build/windows/installer
/build/windows/installer/*
!/build/windows/installer/project.nsi

# Go test binaries
*.test

# Local config symlinks for `wails dev` (point at the repo-root onecreat.toml/.env
# so the desktop app resolves the same config/keys the CLI does). Never commit.
# reasonix.toml kept for the legacy local symlink.
/onecreat.toml
/reasonix.toml
/.env

# `go build` binary produced in-tree (module reasonix/desktop → "desktop")
/desktop
# Wails dependency-change cache
/frontend/package.json.md5
