[
  {
    "id": "arduino_uno",
    "label": "Arduino UNO",
    "platform": "arduino",
    "board": "uno",
    "defaultFramework": "Arduino IDE / Arduino CLI",
    "arduinoFqbn": "arduino:avr:uno",
    "platformioEnv": "uno",
    "platformioBoard": "uno",
    "uploadMethod": "USB serial bootloader",
    "defaultBaud": 115200,
    "logicVoltage": "5V",
    "powerNotes": "USB 5V 供电；电机、舵机和大电流负载必须独立供电并共地。",
    "recommendedProtocols": [
      "GPIO",
      "ADC",
      "I2C",
      "SPI",
      "UART"
    ],
    "defaultPins": [
      {
        "name": "板载 LED",
        "pins": [
          "D13"
        ],
        "protocol": "GPIO",
        "direction": "output",
        "voltage": "5V",
        "notes": "最小验证输出，不需要外接 LED。"
      },
      {
        "name": "I2C",
        "pins": [
          "A4/SDA",
          "A5/SCL"
        ],
        "protocol": "I2C",
        "direction": "bidirectional",
        "voltage": "5V",
        "notes": "多个 I2C 设备可共享，但地址不能冲突。"
      },
      {
        "name": "UART",
        "pins": [
          "D0/RX",
          "D1/TX"
        ],
        "protocol": "UART",
        "direction": "bidirectional",
        "voltage": "5V",
        "notes": "与 USB 串口共用，调试时避免接外部 UART。"
      }
    ],
    "riskyPins": [
      {
        "name": "USB 串口占用",
        "pins": [
          "D0",
          "D1"
        ],
        "protocol": "UART",
        "voltage": "5V",
        "notes": "烧录和 Serial 调试时不要同时接外设。"
      },
      {
        "name": "电流限制",
        "pins": [
          "任意 IO"
        ],
        "protocol": "GPIO",
        "voltage": "5V",
        "notes": "不要直接驱动电机、继电器线圈或大功率 LED。"
      }
    ],
    "toolchains": [
      "arduino-cli",
      "Arduino IDE"
    ],
    "validationFlow": [
      "arduino_compile",
      "arduino_upload",
      "arduino_monitor_sample",
      "hardware_evidence_record"
    ],
    "commonFailures": [
      "fqbn 不匹配",
      "D0/D1 串口被占用",
      "库未安装",
      "执行器未独立供电"
    ],
    "teachingNotes": [
      "UNO RAM 只有 2KB，避免大数组和大字符串。",
      "先用 D13 板载 LED 验证上传链路，再接外设。"
    ],
    "aliases": [
      "arduino",
      "uno",
      "arduino_uno"
    ]
  },
